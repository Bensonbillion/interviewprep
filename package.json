{
  "name": "interviewprep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:ai": "vitest run tests/ai",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome'",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "vitest run && playwright test",
    "test:ci": "vitest run --reporter=verbose && playwright test --reporter=github",
    "security:scan": "npx gitleaks detect --source . --verbose",
    "security:audit": "npm audit --audit-level=high",
    "security:outdated": "npm outdated",
    "postinstall": "echo 'Run npm audit before proceeding'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "^10.42.0",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/pdf-parse": "^1.1.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "openai": "^6.25.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.0.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "unpdf": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
