{
  "name": "interviewprep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:ai": "vitest run tests/ai",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:evals": "npx tsx tests/evals/run-evals.ts",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:db && npm run test:e2e:smoke",
    "security:scan": "npx gitleaks detect --source . --verbose",
    "security:audit": "npm audit --audit-level=high",
    "security:outdated": "npm outdated",
    "postinstall": "echo 'Run npm audit before proceeding'",
    "seed:samsara": "npx tsx scripts/seed-samsara-session.ts",
    "seed:knowledge": "npx tsx scripts/seed-samsara-knowledge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "^10.42.0",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/pdf-parse": "^1.1.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "16.2.4",
    "next-mdx-remote": "^6.0.0",
    "openai": "^6.25.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.0.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "unpdf": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fishery": "^2.4.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "msw": "^2.13.4",
    "next-test-api-route-handler": "^5.0.4",
    "nock": "^14.0.12",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
